  "type": "Manifest",
  "label": {
    "en": [
      "Systems Revisited (1969–1976)"
    ]
  },
  "metadata": [
    {
      "label": {
        "en": [
          "Description"
        ]
      },
      "value": {
        "en": [
          "A documentary exhibition bringing together selected material from Architectural Design, September 1969 to May 1976. It follows the presentation of Systems: Ways and Means in 1969, the Complexity sequence of 1972, and the reconsideration of the systems approach in 1976. The selection is organised into five chronological sections and presents individual contributions as multi-page Canvases where appropriate."
        ]
      }
    }
  ],
  "viewingDirection": "left-to-right",
