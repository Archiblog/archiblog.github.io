      "label": {
        "en": [
          "02 — Learning (p. 207)"
        ]
      },
      "metadata": [
        {
          "label": {
            "en": [
              "Documentary note"
            ]
          },
          "value": {
            "en": [
              "The page announces “LEARNING” in connection with the RIBA conference on “Building for Education: Looking forward”. The editorial text questions education that reproduces existing social and economic patterns, and raises the possibility of a different relationship between learning and the physical infrastructure provided for it. The argument continues on p. 242."
            ]
          }
        },
        {
          "label": {
            "en": [
              "Source reference"
            ]
          },
          "value": {
            "en": [
              "Architectural Design, May 1968, p. 207."
            ]
          }
        }
      ],
