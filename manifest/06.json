      "metadata": [
        {
          "label": {
            "en": [
              "Documentary note"
            ]
          },
          "value": {
            "en": [
              "The OCH proposal combines a public-library scheme with self-service book storage, information systems, architectural drawings and a communications-network diagram. The Record Card draws attention to the connection between physical space, circulation and information retrieval. How these elements relate operationally remains to be investigated."
            ]
          }
        },
