      "label": {
        "en": [
          "05 — A network of educational resources (p. 225)"
        ]
      },
      "metadata": [
        {
          "label": {
            "en": [
              "Documentary note"
            ]
          },
          "value": {
            "en": [
              "The article develops an account of an education-centre network, including its organisation, facilities, spatial requirements and potential for growth. Its tabulated requirements and provision for change suggest an institution extending beyond the individual school. The relationship to Atom remains a question for comparison."
            ]
          }
        },
        {
          "label": {
            "en": [
              "Source reference"
