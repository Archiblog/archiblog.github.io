      "value": {
        "en": [
          "Architectural Design, May 1968 (AD/5/68). Selected pages presented in their original publication sequence, with two Atom double-page spreads retained as spreads."
        ]
      }
    },
    {
      "label": {
        "en": [
          "Documentary method"
        ]
      },
      "value": {
        "en": [
          "Canvas notes are based on the corresponding Record Cards. Descriptions, observations and questions are presented as an initial examination; relationships are to be investigated, not assumed."
        ]
      }
    }
  ],
