        ]
      },
      "metadata": [
        {
          "label": {
            "en": [
              "Documentary note"
            ]
          },
          "value": {
            "en": [
              "A photograph of Orchard Ridge Campus accompanies text on programming and educational change. The article’s title contrasts with the conventional educational building shown, while the text envisages education extending into the home, factory, office and shopping centre."
            ]
          }
        },
        {
          "label": {
