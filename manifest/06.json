      "label": {
        "en": [
          "01 — The question on the cover (Cover)"
        ]
      },
      "metadata": [
        {
          "label": {
            "en": [
              "Documentary note"
            ]
          },
          "value": {
            "en": [
              "The cover of Architectural Design, May 1968, pairs “What about Learning?” with an image of a wristwatch whose face appears to show a film scene. The question is left open; the relationship between learning, the image and time remains to be investigated."
            ]
          }
        },
        {
          "label": {
            "en": [
              "Source reference"
            ]
          },
          "value": {
            "en": [
              "Architectural Design, May 1968, Cover."
            ]
          }
        }
